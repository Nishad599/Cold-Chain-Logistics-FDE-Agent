# Copy to .env and fill in. .env is git-ignored; never commit real passwords.

# --- Postgres (read by the db container AND the Python scripts) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=fde
PG_HOST=127.0.0.1          # not "localhost": on Windows it may try IPv6 (::1) first and hang
PG_PORT=5432              # host port; change it (e.g. 5434) if a local Postgres already uses 5432

# Least-privilege logins created by db/init/01_init.sh on the first DB start
AGENT_DB_PASSWORD=change-me-agent     # fde_agent: read-only fleet view + SOP chunks
INGEST_DB_PASSWORD=change-me-ingest   # fde_ingestor: insert-only raw telemetry (Kafka consumer)
AUDIT_DB_PASSWORD=change-me-audit     # fde_auditor: insert-only audit log

# --- Models ---
Agent_llm=OLLAMA                       # OLLAMA (local) | GROQ (free tier) | DEEPSEEK | OPENAI
Embeddings_model=LOCAL                 # LOCAL (bge-m3) | OPENAI
Local_Embedding_Model=BAAI/bge-m3
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=                        # free key: https://console.groq.com/keys
# GROQ_MODEL=openai/gpt-oss-120b

# --- Kafka (live telemetry simulation) ---
KAFKA_BOOTSTRAP=127.0.0.1:29092   # host port; inside Docker the services use kafka:9092
TELEMETRY_RATE=1                  # readings per second sent by the producer
